# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL: Project URL from Supabase dashboard (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_PUBLISHABLE_KEY: Public client key for frontend Supabase client
VITE_SUPABASE_PUBLISHABLE_KEY=

# SUPABASE_SECRET_KEY: Server-side secret key for backend database operations
SUPABASE_SECRET_KEY=

# ADDIS_API_KEY: For Ethiopian language support (optional)
ADDIS_API_KEY=

# FAL_KEY: For receipt and vision extraction (optional)
FAL_KEY=

# ELEVENLABS_API_KEY: For premium voice TTS (optional)
ELEVENLABS_API_KEY=

# ELEVENLABS_VOICE_ID: The specific voice to use for TTS (optional)
ELEVENLABS_VOICE_ID=
